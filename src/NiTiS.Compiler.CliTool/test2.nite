use std;

module test;

#[no_inline] // compiler attributes
#[no_optimize]
#[stack_trace_ignore]
#[diagnostic()]
private main() -> i32 {
	#if(OperationSystem.IsWindows) // Next statement will be only included on Windows
	return 0i32;

	return 8i32;
}

#where(V >= 2)
public type Vec<T, V: usize> {
	private elements: Slice<T, V>; // Just like `T[V] elements` in C or C++

	public get x: T => *(this as *T + 0);

	public get y: T => *(this as *T + 1);

	// This is not preprocessor's things, but meta tags
	#when(V >= 3) // This is only exists when V is 3 or greater
	public get z: T => *(this as *T + 2);

	#when(V >= 4)
	public get w: T => *(this as *T + 3);
}

public alias Vec2<T> = Vec<T, 2>;
public alias Vec3<T> = Vec<T, 3>;
public alias Vec4<T> = Vec<T, 4>;
public alias Vec5<T> = Vec<T, 5>;