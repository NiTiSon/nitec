#!bin/nite

public lifetime_test3<'a, 'b>(a: &'a i32, b: &'b i32) -> &'b i32
where 'a : 'b + 'b
where 'a : 'b + 'b {
	if (a > b) {
		return a;
	}

	return b;
}

public lifetime_test() {
    let x: i32 = 1;
    let y: &i32 = &x; // valid
}

public lifetime_test2_fail<'a>(ref: &i32) {
	let x = 3;
	ref = &x; // invalid: reference outlives the referred location
}

public main(cond: bool) {
	let x;
	x = 1; // beginning of the x lifetime

	if cond {
		x = 2;
		let ref_x = &x; // valid: cause x is outlive reference
	}
}

