use std;

public main() -> i32 {
	return 1 + 2 + 5 / 2 * 2;
	/* should be translated into syntax tree:
	FunctionDeclaration
    ├──PublicKeyword
    ├──SimpleName
    │  └──Identifier: main
    ├──ParameterList
    ├──RetusaClause
    │  ├──RetusaToken
    │  └──PredefinedType
    │     └──I32Keyword
    └──BlockStatement
       ├──OpenBraceToken
       ├──ReturnStatement
       │  ├──ReturnKeyword
       │  └──AddExpression
       │     ├──AddExpression
       │     │  ├──NumericLiteralExpression
       │     │  │  └──NumberToken: int := 1
       │     │  ├──PlusToken @[64..65)
       │     │  └──NumericLiteralExpression
       │     │     └──NumberToken: int := 2
       │     ├──PlusToken @[68..69)
       │     └──MultiplyExpression
       │        ├──DivideExpression
       │        │  ├──NumericLiteralExpression @[70..71)
       │        │  │  └──NumberToken: int := 5
       │        │  ├──SlashToken @[72..73)
       │        │  └──NumericLiteralExpression
       │        │     └──NumberToken: int := 2
       │        ├──AsteriskToken
       │        └──NumericLiteralExpression
       │           └──NumberToken: int := 2
       └──CloseBraceToken
	Then into MIR:
	$0 = load.i32 1
	$1 = load.i32 2
	$2 = i32.add $0, $1
	$3 = load.i32 5
	$4 = load.i32 2
	$5 = i32.div $3, $4
	$6 = load.i32 2
	$7 = i32.mul $5, $6
	$8 = i32.add $2, $7
	return $8

	$0 = 1
	$1 = 2
	$2 = 3 (1+2)
	$3 = 5
	$4 = 2
	$5 = 2 (5/2)
	$6 = 2
	$7 = 4 (5/2*2)
	$8 = 7 (1+2+5/2*2)
	*/
}

module std;

public type Void;

public type NeverReturn;

module std::numerics;

public type SInt8 {
	private value: i8;
	public static const min_value = -128i8;
	public static const max_value = 127i8;
}

public type SInt16 {
	private value: i16;
	public static const min_value = -32'768i16;
	public static const max_value = 32'767i16;
}

public type SInt32 {
	private value: i32;
    public static const min_value = -2'147'483'648i32;
    public static const max_value = 2'147'483'647i32;
}

public type SInt64 {
	private value: i64;
    public static const min_value = -9'223'372'036'854'775'808i64;
    public static const max_value = 9'223'372'036'854'775'807i64;
}
public type UInt8;
public type UInt16;
public type UInt32;
public type UInt64;
public type Float16;
public type Float32;
public type Float64;

public type Integer; // Abstract: is_signed
public type Number;