use std;

public enum<u8> Inlining {
	default,
	never,
	always,
}

public attribute[function] inline(arg: Inlining);

public main() -> i32 {
	return 1 + 2 + 5 / 2 * 2;
}

module std;

public type NeverReturn;

module std::numerics;

public type SInt8 {
	private value: i8;
	public static const min_value = -128i8;
	public static const max_value = 127i8;
}

public type SInt16 {
	private value: i16;
	public static const min_value = -32'768i16;
	public static const max_value = 32'767i16;
}

public type SInt32 {
	private value: i32;
    public static const min_value = -2'147'483'648i32;
    public static const max_value = 2'147'483'647i32;
}

public type SInt64 {
	private value: i64;
    public static const min_value = -9'223'372'036'854'775'808i64;
    public static const max_value = 9'223'372'036'854'775'807i64;
}
public type UInt8;
public type UInt16;
public type UInt32;
public type UInt64;
public type Float16;
public type Float32;
public type Float64;

public type Integer; // Abstract: is_signed
public type Number;

public type Test {
	public ref_value: &i32; // reference to i32
}

public get_test() -> Test {
	let x = 32;
	let test = Test();
	test.ref_value = &x;

	return test;
}